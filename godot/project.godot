; Engine configuration file.
; Postcard City playable Godot demo

config_version=5

[application]
config/name="Postcard City"
run/main_scene="res://scenes/screens/city_builder.tscn"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.06, 0.08, 1)

[input]
select_primary={"deadzone": 0.5, "events": [Object(InputEventMouseButton,"button_index":1)]}
advance_time={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":32)]}
