; Godot 4 project configuration file.
; The presentation prototype is intentionally isolated from the Python simulator.
config_version=5

[application]
config/name="Postcard City Vertical Slice"
run/main_scene="res://scenes/app/bootstrap.tscn"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[autoload]
AppRouter="*res://scripts/app_router.gd"
SettingsService="*res://scripts/settings_service.gd"
