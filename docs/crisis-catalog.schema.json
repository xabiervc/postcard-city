{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Postcard City Crisis Catalog Entry",
  "type": "object",
  "required": [
    "id",
    "family",
    "minimum_level",
    "severity",
    "phases",
    "signals",
    "consequences",
    "decisions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "family": {
      "enum": [
        "natural",
        "infrastructure",
        "accident",
        "public_health",
        "deliberate_violence",
        "geopolitical",
        "economic"
      ]
    },
    "minimum_level": {
      "enum": [
        "relaxed",
        "standard",
        "advanced",
        "expert"
      ]
    },
    "severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "phases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "prevention",
          "preparedness",
          "response",
          "recovery"
        ]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    }
  },
  "additionalProperties": false
}
